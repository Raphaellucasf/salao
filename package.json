{
  "name": "otimiza-beauty",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:security": "node tests/security-guard-validator.js",
    "test:database-hardening": "node tests/database-hardening-validator.js",
    "test:performance-cache": "node tests/performance-cache-validator.js",
    "test:architecture": "node tests/architecture-validator.js",
    "test:quality": "node tests/code-quality-validator.js",
    "test:api-observability": "node tests/api-observability-validator.js",
    "test:secrets": "node tests/secret-scan-validator.js",
    "verify:key-rotation": "node tests/key-rotation-validator.js",
    "test:e2e": "playwright test",
    "test:public-quality": "playwright test tests/e2e/specs/public-quality.spec.ts --project=chromium",
    "verify": "npm run test:security && npm run test:database-hardening && npm run test:performance-cache && npm run test:architecture && npm run test:quality && npm run test:api-observability && npm run test:secrets && npx tsc --noEmit --incremental false",
    "test:e2e:ui": "playwright test --ui"
  },
